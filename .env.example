# Banxico SIE API token — required for live FX rate
# Request one at: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# Fallback MXN→USD rate used if the Banxico API is unreachable or the token is missing.
EXCHANGE_RATE_FALLBACK=18.50

# Google Sheets ID (the long id in the sheet URL) that api/sheets/append.ts
# appends expense rows to.
SPREADSHEET_ID=

# Google service-account credentials JSON (as a single-line string) used by
# api/sheets/append.ts to authenticate to the Sheets API. Grant this service
# account edit access to the target spreadsheet.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Shared secret required by api/sheets/append.ts. Callers must send it as
# either `Authorization: Bearer <secret>` or `x-api-key: <secret>`. Generate a
# long random value (e.g. `openssl rand -hex 32`) — do not reuse this placeholder.
SHEETS_APPEND_SECRET=
