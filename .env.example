# Banxico SIE API token — required for live FX rate
# Request one at: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# Fallback MXN→USD rate used if the Banxico API is unreachable or the token is missing.
EXCHANGE_RATE_FALLBACK=18.50

# Google Sheets ID (the long id in the sheet URL) that api/sheets/append.ts
# appends expense rows to.
SPREADSHEET_ID=

# Google service-account credentials JSON (as a single-line string) used by
# api/sheets/append.ts to authenticate to the Sheets API. Grant this service
# account edit access to the target spreadsheet.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Shared secret required by api/sheets/append.ts. Callers must send it as
# either `Authorization: Bearer <secret>` or `x-api-key: <secret>`. Generate a
# long random value (e.g. `openssl rand -hex 32`) — do not reuse this placeholder.
SHEETS_APPEND_SECRET=

# --- Roseta Café · Solicitud de factura (api/roseta/*.ts) ---

# Resend (resend.com) API key used to email the "Factura por consumo
# solicitada" request — with the CSF and ticket attached — to
# roseta.cafeteria@gmail.com and roseta@acaciaco.com.mx.
RESEND_API_KEY=

# Sender identity for that email. Requires a domain verified in Resend (DNS
# records on acaciaco.com.mx) — Resend cannot send "from" a Gmail address, so
# this must be a mailbox on a domain you control and have verified there.
RESEND_FROM_EMAIL="Roseta Café <facturacion@acaciaco.com.mx>"

# Google Sheet used to track invoice requests (Estatus: Pendiente/Facturada,
# for the public /roseta/factura/estatus lookup) and to remember each RFC's
# fiscal data for autofill on future requests. Create a new spreadsheet with
# two tabs — "Solicitudes" and "ClientesRFC" — and share it (Editor access)
# with the same service account email used in GOOGLE_SERVICE_ACCOUNT_JSON
# above. Then paste its ID (from the sheet's URL) here.
ROSETA_FACTURA_SPREADSHEET_ID=

# Anthropic API key used by api/roseta/factura-extract.ts to read uploaded
# CSF and ticket photos (Claude vision) and pre-fill the invoice form. If
# missing or the call fails, extraction is skipped and the customer just
# fills the form manually — it's a convenience, never a hard requirement.
ANTHROPIC_API_KEY=
