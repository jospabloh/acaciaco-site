/**
 * Baristop v2 — Google Apps Script Web App (container-bound to the content Sheet).
 *
 * Files in the Apps Script project: Code.gs (this one), Shared, DefaultContent,
 * appsscript.json. Pure logic lives in Shared.js so it can be unit-tested in node;
 * this file only holds the glue to Sheets / Drive / Mail / Cache / Lock services.
 *
 * Transport: every call is POST with a text/plain JSON body (no CORS preflight).
 * Responses are always HTTP 200 with { ok: true, data } or { ok: false, error }.
 *
 * Script Properties used:
 *   ADMIN_PASSWORD_PLAIN   temporary, read and deleted by setup()
 *   ADMIN_PASSWORD_SHA256  hex SHA-256 of the admin password (fail closed when missing)
 *   ADMIN_TOKEN_SECRET     HMAC key for session tokens (generated by setup())
 *   DRIVE_FOLDER_ID        folder that receives uploaded images (created by setup())
 */

var CONTENT_CACHE_KEY = "content:v1";
var CONTENT_TTL_SEC = 300;
var TOKEN_TTL_SEC = 12 * 3600;
var DRIVE_FOLDER_NAME = "Baristop web — imágenes";
var MAX_BODY_CHARS = 1500000;

var MSG_GENERIC = "Algo salió mal. Intenta de nuevo.";
var MSG_RATE_LOGIN = "Demasiados intentos. Espera 15 minutos e intenta de nuevo.";
var MSG_RATE_QUOTE = "Recibimos varias solicitudes seguidas. Intenta en unos minutos o escríbenos por WhatsApp.";

// ------------------------------------------------------------------- routing

function doGet(e) {
  var p = (e && e.parameter) || {};
  // Only the public read is allowed on GET (handy in a browser tab).
  if (p.action === "getContent") return respond_(run_({ action: "getContent" }));
  return respond_(fail_("BAD_REQUEST", "Solicitud no válida."));
}

function doPost(e) {
  var raw = e && e.postData ? e.postData.contents : "";
  if (typeof raw !== "string" || raw.length === 0 || raw.length > MAX_BODY_CHARS) {
    return respond_(fail_("BAD_REQUEST", "Solicitud no válida."));
  }
  var body;
  try {
    body = JSON.parse(raw);
  } catch (err) {
    return respond_(fail_("BAD_REQUEST", "Solicitud no válida."));
  }
  if (!body || typeof body !== "object" || Array.isArray(body)) {
    return respond_(fail_("BAD_REQUEST", "Solicitud no válida."));
  }
  return respond_(run_(body));
}

function run_(body) {
  try {
    switch (body.action) {
      case "getContent": return ok_(getContent_(body));
      case "login": return ok_(login_(body));
      case "saveSection": return ok_(saveSection_(body));
      case "uploadImage": return ok_(uploadImage_(body));
      case "submitQuote": return ok_(submitQuote_(body));
      default: return fail_("BAD_REQUEST", "Acción no válida.");
    }
  } catch (err) {
    if (err && err.apiCode) return fail_(err.apiCode, err.message, err.details);
    console.error(err && err.stack ? err.stack : String(err));
    return fail_("SERVER_ERROR", MSG_GENERIC);
  }
}

function ok_(data) {
  return { ok: true, data: data };
}

function fail_(code, message, details) {
  var out = { ok: false, error: { code: code, message: message } };
  if (details) out.error.details = details;
  return out;
}

function throwApi_(code, message, details) {
  var err = new Error(message);
  err.apiCode = code;
  err.details = details;
  throw err;
}

function respond_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

// ------------------------------------------------------------------ helpers

function props_() {
  return PropertiesService.getScriptProperties();
}

function nowSec_() {
  return Math.floor(Date.now() / 1000);
}

function bytesToHex_(bytes) {
  var out = "";
  for (var i = 0; i < bytes.length; i++) {
    var b = (bytes[i] + 256) % 256;
    out += (b < 16 ? "0" : "") + b.toString(16);
  }
  return out;
}

function sha256Hex_(str) {
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(str), Utilities.Charset.UTF_8);
  return bytesToHex_(bytes);
}

function stripPadding_(s) {
  return s.replace(/=+$/, "");
}

function signPayload_(payload) {
  var secret = props_().getProperty("ADMIN_TOKEN_SECRET");
  if (!secret) throwApi_("NOT_CONFIGURED", "El panel no está configurado todavía.");
  var sig = Utilities.computeHmacSha256Signature(payload, secret);
  return stripPadding_(Utilities.base64EncodeWebSafe(sig));
}

function requireAuth_(token) {
  if (!Shared.isTokenValid(token, nowSec_(), signPayload_)) {
    throwApi_("UNAUTHORIZED", "Tu sesión expiró. Vuelve a entrar.");
  }
}

function spreadsheet_() {
  return SpreadsheetApp.getActiveSpreadsheet();
}

// Fixed-window counters in CacheService (best-effort: entries may be evicted early).
function readCounter_(key, windowSec) {
  var raw = CacheService.getScriptCache().get(key);
  if (!raw) return 0;
  try {
    var c = JSON.parse(raw);
    if (nowSec_() - c.t > windowSec) return 0;
    return c.n | 0;
  } catch (e) {
    return 0;
  }
}

function bumpCounter_(key, windowSec) {
  var lock = LockService.getScriptLock();
  var locked = false;
  try {
    locked = lock.tryLock(2000);
  } catch (e) {
    locked = false;
  }
  try {
    var cache = CacheService.getScriptCache();
    var raw = cache.get(key);
    var c = null;
    if (raw) {
      try { c = JSON.parse(raw); } catch (e2) { c = null; }
    }
    if (!c || nowSec_() - c.t > windowSec) c = { n: 0, t: nowSec_() };
    c.n += 1;
    var left = Math.max(1, windowSec - (nowSec_() - c.t));
    cache.put(key, JSON.stringify(c), Math.min(left, 21600));
    return c.n;
  } finally {
    if (locked) lock.releaseLock();
  }
}

// Increments and reports whether the caller is still within the limit.
function hit_(key, limit, windowSec) {
  return bumpCounter_(key, windowSec) <= limit;
}

// -------------------------------------------------------------- sheet access

function readTab_(ss, section) {
  var def = Shared.SCHEMA.sections[section];
  var sheet = ss.getSheetByName(def.tab);
  if (!sheet) throwApi_("SERVER_ERROR", "Falta la pestaña " + def.tab + ". Ejecuta setup() en el editor.");
  var lastRow = sheet.getLastRow();
  var lastCol = sheet.getLastColumn();
  if (lastRow < 1 || lastCol < 1) throwApi_("SERVER_ERROR", "La pestaña " + def.tab + " está vacía. Ejecuta setup() en el editor.");
  var values = sheet.getRange(1, 1, lastRow, lastCol).getValues();
  return { header: values[0], rows: values.slice(1) };
}

function buildContent_() {
  var ss = spreadsheet_();
  var tabs = {};
  for (var i = 0; i < Shared.SECTION_NAMES.length; i++) {
    var name = Shared.SECTION_NAMES[i];
    tabs[Shared.SCHEMA.sections[name].tab] = readTab_(ss, name);
  }
  try {
    return Shared.rowsToContent(tabs);
  } catch (err) {
    throwApi_("SERVER_ERROR", err.message);
  }
}

function putCache_(content) {
  try {
    CacheService.getScriptCache().put(CONTENT_CACHE_KEY, JSON.stringify(content), CONTENT_TTL_SEC);
  } catch (e) {
    // Too large or cache unavailable: the next read simply goes to the Sheet.
  }
}

// Full document (private fields included). Callers decide what to expose.
function loadContent_(forceFresh) {
  if (!forceFresh) {
    var cached = CacheService.getScriptCache().get(CONTENT_CACHE_KEY);
    if (cached) {
      try { return JSON.parse(cached); } catch (e) { /* rebuild below */ }
    }
  }
  var content = buildContent_();
  putCache_(content);
  return content;
}

// ------------------------------------------------------------------ actions

function getContent_(body) {
  var hasToken = body.token !== undefined && body.token !== null && body.token !== "";
  if (hasToken) requireAuth_(body.token);
  if (body.fresh === true && !hasToken) throwApi_("UNAUTHORIZED", "Tu sesión expiró. Vuelve a entrar.");
  var content = loadContent_(body.fresh === true);
  return hasToken ? content : Shared.stripPrivate(content);
}

function login_(body) {
  var clientId = body.clientId;
  if (typeof clientId !== "string" || !/^[0-9a-f-]{36}$/.test(clientId)) {
    throwApi_("BAD_REQUEST", "Solicitud no válida.");
  }
  var storedHash = props_().getProperty("ADMIN_PASSWORD_SHA256");
  if (!Shared.sha256HexIsValid(storedHash) || !props_().getProperty("ADMIN_TOKEN_SECRET")) {
    throwApi_("NOT_CONFIGURED", "El panel no está configurado todavía.");
  }
  var clientKey = "login:fail:" + clientId;
  if (readCounter_(clientKey, 900) >= 6 || readCounter_("login:fail:all", 900) >= 60) {
    throwApi_("RATE_LIMITED", MSG_RATE_LOGIN);
  }
  var password = body.password;
  var good = typeof password === "string" && password.length > 0 && password.length <= 200 &&
    Shared.safeEqual(sha256Hex_(password), storedHash);
  if (!good) {
    bumpCounter_(clientKey, 900);
    bumpCounter_("login:fail:all", 900);
    throwApi_("UNAUTHORIZED", "Contraseña incorrecta.");
  }
  var exp = nowSec_() + TOKEN_TTL_SEC;
  var payload = "v1." + exp + "." + Utilities.getUuid();
  return { token: payload + "." + signPayload_(payload), expiresAt: new Date(exp * 1000).toISOString() };
}

function saveSection_(body) {
  requireAuth_(body.token);
  var section = body.section;
  if (typeof section !== "string" || Shared.SECTION_NAMES.indexOf(section) === -1) {
    throwApi_("BAD_REQUEST", "Sección no válida.");
  }
  var rows = body.rows;
  var ss = spreadsheet_();
  var ctx = {};
  if (section === "machines") {
    var catTab = readTab_(ss, "machineryCategories");
    var cats = Shared.rowsToItems("machineryCategories", catTab.header, catTab.rows);
    ctx.categoryIds = cats.map(function (c) { return c.id; });
  }
  var check = Shared.validateSection(section, rows, ctx);
  if (!check.ok) {
    var first = check.errors.slice(0, 10);
    throwApi_("VALIDATION", first[0].message, first);
  }

  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
  } catch (e) {
    throwApi_("SERVER_ERROR", "El panel está ocupado guardando otro cambio. Intenta de nuevo.");
  }
  try {
    var iso = new Date().toISOString();
    if (section === "site") {
      writeSettings_(ss, rows, iso);
    } else {
      writeList_(ss, section, rows);
      setUpdatedAt_(ss, iso);
    }
    SpreadsheetApp.flush();
    var content = buildContent_();
    putCache_(content);
    return content;
  } finally {
    lock.releaseLock();
  }
}

function ensureRows_(sheet, needed) {
  var max = sheet.getMaxRows();
  if (needed > max) sheet.insertRowsAfter(max, needed - max);
}

function clearBody_(sheet) {
  var lastRow = sheet.getLastRow();
  if (lastRow > 1) sheet.getRange(2, 1, lastRow - 1, Math.max(1, sheet.getLastColumn())).clearContent();
}

// Writes rows below the header. Every text column is forced to plain-text format first,
// so a value such as "=1+1" or "@usuario" is stored literally and never evaluated as a formula.
function writeRows_(sheet, def, header, data) {
  if (!data.length) return;
  ensureRows_(sheet, data.length + 1);
  var names = header.map(function (v) { return String(v).trim(); });
  var textHeaders = def.kind === "settings" ? def.headers : def.fields.filter(function (f) {
    return f.type !== "boolean" && f.type !== "number";
  }).map(function (f) { return f.header; });
  textHeaders.forEach(function (h) {
    var col = names.indexOf(h) + 1;
    if (col > 0) sheet.getRange(2, col, data.length, 1).setNumberFormat("@");
  });
  sheet.getRange(2, 1, data.length, header.length).setValues(data);
}

// Replaces the body of a tab with rollback: the previous body is snapshotted first and
// restored if the write throws, so a failed save never leaves the tab with only its header.
function replaceBody_(sheet, def, header, data) {
  var lastRow = sheet.getLastRow();
  var lastCol = Math.max(1, sheet.getLastColumn());
  var snapshot = lastRow > 1 ? sheet.getRange(2, 1, lastRow - 1, lastCol).getValues() : [];
  try {
    clearBody_(sheet);
    writeRows_(sheet, def, header, data);
  } catch (err) {
    try {
      clearBody_(sheet);
      if (snapshot.length) sheet.getRange(2, 1, snapshot.length, lastCol).setValues(snapshot);
    } catch (restoreErr) {
      // Restore failed too: drop the cache so the next read reflects the sheet as it is.
      try { CacheService.getScriptCache().remove(CACHE_KEY); } catch (e) {}
    }
    throw err;
  }
}

function writeList_(ss, section, items) {
  var tab = readTab_(ss, section);
  var sheet = ss.getSheetByName(Shared.SCHEMA.sections[section].tab);
  var data;
  try {
    data = Shared.itemsToRows(section, tab.header, items);
  } catch (err) {
    throwApi_("SERVER_ERROR", err.message);
  }
  replaceBody_(sheet, Shared.SCHEMA.sections[section], tab.header, data);
}

function writeSettings_(ss, obj, iso) {
  var tab = readTab_(ss, "site");
  var sheet = ss.getSheetByName(Shared.SCHEMA.sections.site.tab);
  var idx = Shared.headerIndex(tab.header, "site");
  var descriptions = {};
  tab.rows.forEach(function (r) {
    var k = String(r[idx.key] == null ? "" : r[idx.key]).trim();
    if (k && idx.description !== -1) descriptions[k] = String(r[idx.description] || "");
  });
  var flat = {};
  Object.keys(obj).forEach(function (k) { flat[k] = obj[k]; });
  flat._updatedAt = iso;
  var settings = Shared.objectToSettings(flat, descriptions);
  var width = tab.header.length;
  var data = settings.map(function (r) {
    var row = [];
    for (var c = 0; c < width; c++) row.push("");
    row[idx.key] = r[0];
    row[idx.value] = r[1];
    if (idx.description !== -1) row[idx.description] = r[2];
    return row;
  });
  replaceBody_(sheet, Shared.SCHEMA.sections.site, tab.header, data);
}

// Stores the content version in Ajustes (key _updatedAt) without touching other rows.
function setUpdatedAt_(ss, iso) {
  var tab = readTab_(ss, "site");
  var sheet = ss.getSheetByName(Shared.SCHEMA.sections.site.tab);
  var idx = Shared.headerIndex(tab.header, "site");
  for (var i = 0; i < tab.rows.length; i++) {
    if (String(tab.rows[i][idx.key]).trim() === "_updatedAt") {
      sheet.getRange(i + 2, idx.value + 1).setValue(iso);
      return;
    }
  }
  var row = tab.rows.length + 2;
  ensureRows_(sheet, row);
  sheet.getRange(row, idx.key + 1).setValue("_updatedAt");
  sheet.getRange(row, idx.value + 1).setValue(iso);
}

function uploadImage_(body) {
  requireAuth_(body.token);
  var meta = Shared.validateUploadMeta(body);
  if (!meta.ok) throwApi_("VALIDATION", meta.error);
  var folderId = props_().getProperty("DRIVE_FOLDER_ID");
  if (!folderId) throwApi_("NOT_CONFIGURED", "La carpeta de imágenes aún no existe. Ejecuta setup() en el editor.");

  var bytes;
  try {
    bytes = Utilities.base64Decode(body.dataBase64);
  } catch (e) {
    throwApi_("VALIDATION", "La imagen no es válida.");
  }
  if (bytes.length > meta.maxBytes) throwApi_("VALIDATION", "La imagen pesa demasiado. Máximo " + meta.spec.maxKB + " KB.");

  var head = "";
  if (body.mime === "image/svg+xml") {
    head = Utilities.newBlob(bytes).getDataAsString("UTF-8");
    if (!Shared.isSafeSvgText(head)) throwApi_("VALIDATION", "El SVG no es válido o contiene elementos no permitidos.");
  }
  if (Shared.sniffImageType(bytes, head) !== body.mime) {
    throwApi_("VALIDATION", "El archivo no coincide con el formato de imagen indicado.");
  }

  var stamp = Utilities.formatDate(new Date(), "America/Mexico_City", "yyyyMMdd-HHmmss");
  var fileName = body.section + "-" + body.itemId + "-" + stamp + "." + meta.ext;
  var file = DriveApp.getFolderById(folderId).createFile(Utilities.newBlob(bytes, body.mime, fileName));
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  var id = file.getId();
  return { url: "https://lh3.googleusercontent.com/d/" + id, fileId: id, bytes: bytes.length };
}

function submitQuote_(body) {
  var content = loadContent_(false);
  var visible = (content.branches || []).filter(function (b) { return b.visible !== false; });
  var check = Shared.validateQuote(body, { branchIds: visible.map(function (b) { return b.id; }) });
  if (check.silent) return { sent: true, recipientsCount: 0 };
  if (!check.ok) throwApi_("VALIDATION", "Revisa los datos del formulario.", check.errors);

  var contactKey = "quote:contact:" + sha256Hex_(String(body.contact).trim().toLowerCase());
  if (!hit_("quote:minute", 10, 60) || !hit_("quote:hour", 60, 3600) || !hit_(contactKey, 3, 3600)) {
    throwApi_("RATE_LIMITED", MSG_RATE_QUOTE);
  }
  var branch = visible.filter(function (b) { return b.id === body.branchId; })[0];
  return deliverQuote_(body, branch, content.site || {});
}

// Sends the mail and logs the row. Mail first, log second.
function deliverQuote_(body, branch, site) {
  var to = Shared.resolveRecipients(branch, site);
  if (to.length === 0) {
    throwApi_("NOT_CONFIGURED", "El formulario aún no tiene destinatarios. Escríbenos por WhatsApp.");
  }
  var now = new Date();
  var when = Utilities.formatDate(now, "America/Mexico_City", "dd/MM/yyyy HH:mm");
  var mail = Shared.buildQuoteEmail(body, branch, site, now.toISOString(), when);
  var status = "Enviado";
  var failure = null;
  try {
    if (MailApp.getRemainingDailyQuota() < to.length) {
      throw new Error("Cuota diaria de correo agotada");
    }
    var options = { to: to.join(","), subject: mail.subject, body: mail.text, htmlBody: mail.html, name: "Baristop web" };
    if (mail.replyTo) options.replyTo = mail.replyTo;
    MailApp.sendEmail(options);
  } catch (err) {
    console.error(err && err.stack ? err.stack : String(err));
    status = "Error: " + String(err && err.message ? err.message : err).slice(0, 200);
    failure = err;
  }
  logQuote_([
    when, branch.name, body.name, body.business || "", body.contact, body.need, body.message || "",
    to.join(", "), status,
  ]);
  if (failure) {
    throwApi_("SERVER_ERROR", "No pudimos enviar tu solicitud. Intenta de nuevo o escríbenos por WhatsApp.");
  }
  return { sent: true, recipientsCount: to.length };
}

function logQuote_(cells) {
  try {
    var sheet = spreadsheet_().getSheetByName(Shared.SCHEMA.logs.quotes.tab);
    if (!sheet) return;
    var row = cells.map(function (c) { return String(c == null ? "" : c); });
    var lock = LockService.getScriptLock();
    var locked = false;
    try { locked = lock.tryLock(5000); } catch (e) { locked = false; }
    try {
      var target = sheet.getRange(sheet.getLastRow() + 1, 1, 1, row.length);
      target.setNumberFormat("@"); // plain text: user input is never evaluated as a formula
      target.setValues([row]);
    } finally {
      if (locked) lock.releaseLock();
    }
  } catch (err) {
    console.error("No se pudo registrar la cotización: " + (err && err.stack ? err.stack : err));
  }
}

// ------------------------------------------------- editor-run maintenance

function setup() {
  var ss = spreadsheet_();
  var report = [];
  Shared.SECTION_NAMES.forEach(function (name) {
    var def = Shared.SCHEMA.sections[name];
    var sheet = ensureSheet_(ss, def.tab, sectionHeaders_(def), report);
    seedTab_(sheet, name, def, report); // before formatTab_: checkboxes fill every row
    formatTab_(sheet, def);
  });
  var q = Shared.SCHEMA.logs.quotes;
  var logSheet = ensureSheet_(ss, q.tab, q.headers, report);
  logSheet.setColumnWidths(1, q.headers.length, 160);
  logSheet.getRange(2, 1, Math.max(logSheet.getMaxRows() - 1, 1), q.headers.length).setNumberFormat("@");

  var p = props_();
  if (!p.getProperty("ADMIN_TOKEN_SECRET")) {
    p.setProperty("ADMIN_TOKEN_SECRET", Utilities.getUuid() + Utilities.getUuid());
    report.push("Se generó ADMIN_TOKEN_SECRET.");
  }
  var folderId = p.getProperty("DRIVE_FOLDER_ID");
  var folderOk = false;
  if (folderId) {
    try { DriveApp.getFolderById(folderId); folderOk = true; } catch (e) { folderOk = false; }
  }
  if (!folderOk) {
    var folder = DriveApp.createFolder(DRIVE_FOLDER_NAME);
    p.setProperty("DRIVE_FOLDER_ID", folder.getId());
    report.push('Se creó la carpeta de Drive "' + DRIVE_FOLDER_NAME + '".');
  }
  report.push(applyAdminPassword_());
  CacheService.getScriptCache().remove(CONTENT_CACHE_KEY);
  console.log("setup() terminó:\n- " + report.join("\n- "));
}

function ensureSheet_(ss, title, headers, report) {
  var sheet = ss.getSheetByName(title);
  if (!sheet) {
    sheet = ss.insertSheet(title);
    report.push("Pestaña creada: " + title);
  }
  var lastCol = Math.max(sheet.getLastColumn(), 1);
  var existing = sheet.getRange(1, 1, 1, lastCol).getValues()[0].map(function (v) { return String(v).trim(); });
  var empty = existing.every(function (v) { return v === ""; });
  if (empty) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  } else {
    // Older copy: append any header that is missing, never reorder what is there.
    var next = existing.length;
    while (next > 0 && existing[next - 1] === "") next--;
    headers.forEach(function (h) {
      if (existing.indexOf(h) === -1) {
        sheet.getRange(1, next + 1).setValue(h);
        existing[next] = h;
        next++;
        report.push('Se agregó la columna "' + h + '" a ' + title);
      }
    });
  }
  sheet.setFrozenRows(1);
  var width = Math.max(sheet.getLastColumn(), headers.length);
  sheet.getRange(1, 1, 1, width).setFontWeight("bold").setBackground("#F3E8D6");
  return sheet;
}

function sectionHeaders_(def) {
  return def.kind === "settings" ? def.headers.slice() : def.fields.map(function (f) { return f.header; });
}

function formatTab_(sheet, def) {
  if (def.kind !== "list") return;
  var header = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map(function (v) { return String(v).trim(); });
  var rows = Math.max(sheet.getMaxRows() - 1, 1);
  def.fields.forEach(function (f) {
    var col = header.indexOf(f.header) + 1;
    if (col < 1) return;
    var range = sheet.getRange(2, col, rows, 1);
    if (f.type === "boolean") {
      range.setDataValidation(SpreadsheetApp.newDataValidation().requireCheckbox().build());
    } else if (f.type === "digits" || f.type === "date" || f.key === "id" || f.key === "categoryId") {
      range.setNumberFormat("@"); // keep leading zeros and ISO dates as typed
    }
  });
}

function seedTab_(sheet, name, def, report) {
  var d = DEFAULT_CONTENT;
  if (tabHasData_(sheet)) return;
  if (name === "site") {
    var flat = {};
    Object.keys(d.site).forEach(function (k) { flat[k] = d.site[k]; });
    flat._updatedAt = new Date().toISOString();
    var rows = Shared.objectToSettings(flat, {});
    var header = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    var idx = Shared.headerIndex(header, "site");
    var data = rows.map(function (r) {
      var row = [];
      for (var c = 0; c < header.length; c++) row.push("");
      row[idx.key] = r[0];
      row[idx.value] = r[1];
      if (idx.description !== -1) row[idx.description] = r[2];
      return row;
    });
    writeRows_(sheet, def, header, data);
    report.push("Textos iniciales cargados en " + def.tab);
    return;
  }
  var items = d[name] || [];
  if (!items.length) return;
  var head = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  var out = Shared.itemsToRows(name, head, items);
  writeRows_(sheet, def, head, out);
  report.push("Datos iniciales cargados en " + def.tab);
}

// getLastRow() counts checkbox rows, so look for a row with real content instead.
function tabHasData_(sheet) {
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return false;
  var rows = sheet.getRange(2, 1, lastRow - 1, Math.max(sheet.getLastColumn(), 1)).getValues();
  return rows.some(function (row) { return !Shared.isBlankRow(row); });
}

// Reads ADMIN_PASSWORD_PLAIN, stores its SHA-256, deletes the plain value.
function applyAdminPassword_() {
  var p = props_();
  var plain = p.getProperty("ADMIN_PASSWORD_PLAIN");
  if (!plain) {
    return Shared.sha256HexIsValid(p.getProperty("ADMIN_PASSWORD_SHA256"))
      ? "Contraseña del panel: ya configurada."
      : "ATENCIÓN: falta ADMIN_PASSWORD_PLAIN. Agrégala en Propiedades del script y vuelve a ejecutar setup().";
  }
  if (plain.length < 8) {
    throw new Error("La contraseña del panel debe tener al menos 8 caracteres. Corrige ADMIN_PASSWORD_PLAIN y vuelve a ejecutar.");
  }
  var changed = p.getProperty("ADMIN_PASSWORD_SHA256") !== sha256Hex_(plain);
  p.setProperty("ADMIN_PASSWORD_SHA256", sha256Hex_(plain));
  p.deleteProperty("ADMIN_PASSWORD_PLAIN");
  if (changed && p.getProperty("ADMIN_TOKEN_SECRET")) {
    // A new password closes every open session.
    p.setProperty("ADMIN_TOKEN_SECRET", Utilities.getUuid() + Utilities.getUuid());
  }
  return "Contraseña del panel guardada (cifrada) y ADMIN_PASSWORD_PLAIN eliminada.";
}

function setAdminPasswordFromProperty() {
  console.log(applyAdminPassword_());
}

function rotateTokenSecret() {
  props_().setProperty("ADMIN_TOKEN_SECRET", Utilities.getUuid() + Utilities.getUuid());
  console.log("Listo: todas las sesiones del panel quedaron cerradas.");
}

function clearCache() {
  CacheService.getScriptCache().remove(CONTENT_CACHE_KEY);
  console.log("Caché de contenido borrada.");
}

function testQuote() {
  var content = buildContent_();
  var branch = (content.branches || []).filter(function (b) { return b.id === "ags"; })[0] || content.branches[0];
  if (!branch) throw new Error("No hay sucursales en la pestaña Sucursales.");
  var result = deliverQuote_({
    branchId: branch.id,
    name: "Prueba de cotización",
    business: "Baristop web",
    // Not Session.getEffectiveUser(): that needs the userinfo.email scope.
    contact: String((content.site || {}).quoteAlwaysTo || "").split(/[,\s]+/)[0] || "0000000000",
    need: Shared.QUOTE_NEEDS[0],
    message: "Correo de prueba enviado desde el editor de Apps Script.",
  }, branch, content.site || {});
  console.log("Correo de prueba enviado a " + result.recipientsCount + " destinatario(s). Cuota restante hoy: " + MailApp.getRemainingDailyQuota());
}
