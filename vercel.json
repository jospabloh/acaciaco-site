{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/finflow",
      "destination": "/apps/flowfin",
      "permanent": true
    },
    {
      "source": "/bienvenida",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/bolsa-empleo",
      "destination": "/trabaja-con-nosotros",
      "permanent": true
    },
    {
      "source": "/rumbo",
      "destination": "/apps/rumbo",
      "permanent": true
    },
    {
      "source": "/stockflow",
      "destination": "/apps/stockflow",
      "permanent": true
    },
    {
      "source": "/flowfin",
      "destination": "/apps/flowfin",
      "permanent": true
    },
    {
      "source": "/liuma",
      "destination": "/apps/liuma",
      "permanent": true
    },
    {
      "source": "/puntosplus",
      "destination": "/apps/puntos-plus",
      "permanent": true
    },
    {
      "source": "/catequesis",
      "destination": "/apps/cateqhub",
      "permanent": true
    },
    {
      "source": "/apps/catequesis-qr",
      "destination": "/apps/cateqhub",
      "permanent": true
    },
    {
      "source": "/plink-fx",
      "destination": "/freeware/plink-fx",
      "permanent": true
    },
    {
      "source": "/freeware/plink-FX",
      "destination": "/freeware/plink-fx",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/legal/privacidad",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/legal/terminos",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "browsing-topics=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://unpkg.com https://cdn.jsdelivr.net; connect-src 'self' https:; worker-src 'self' blob:; frame-src 'self' https://www.mercadopago.com.mx https://docs.google.com https://base44.com; form-action 'self' https://www.mercadopago.com.mx https://docs.google.com; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(underconstruction)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/styles/base.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/scripts/shared.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/scripts/analytics.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
