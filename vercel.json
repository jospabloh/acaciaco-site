{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/finflow",
      "destination": "/apps/flowfin",
      "permanent": true
    },
    {
      "source": "/bienvenida",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/rumbo",
      "destination": "/apps/rumbo",
      "permanent": true
    },
    {
      "source": "/stockflow",
      "destination": "/apps/stockflow",
      "permanent": true
    },
    {
      "source": "/flowfin",
      "destination": "/apps/flowfin",
      "permanent": true
    },
    {
      "source": "/liuma",
      "destination": "/apps/liuma",
      "permanent": true
    },
    {
      "source": "/puntosplus",
      "destination": "/apps/puntos-plus",
      "permanent": true
    },
    {
      "source": "/plink-fx",
      "destination": "/freeware/plink-fx",
      "permanent": true
    },
    {
      "source": "/freeware/plink-FX",
      "destination": "/freeware/plink-fx",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/legal/privacidad",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/legal/terminos",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(pricing|trial|faq|apps|bolsa-empleo|underconstruction)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/css/site.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/js/site.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles/base.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/scripts/shared.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
